@implements IDisposable
@inject CalendarState State
@inject AuthService AuthService
@inject NavigationManager Nav

<header class="topbar">
    <!-- Left: hamburger + logo + nav -->
    <div class="topbar-left">
        <button class="btn-icon" id="btn-today" @onclick="State.GoToToday">Hôm nay</button>
        <button class="btn-icon nav-arrow" @onclick="State.NavigatePrev">&#8249;</button>
        <button class="btn-icon nav-arrow" @onclick="State.NavigateNext">&#8250;</button>
        <span class="topbar-title">@State.GetTopbarTitle()</span>
    </div>

    <!-- Right: view mode dropdown + logout -->
    <div class="topbar-right">
        <select class="view-select input-select" id="view-mode-select"
                value="@State.ViewMode.ToString()"
                @onchange="OnViewModeChange">
            <option value="Day">Ngày</option>
            <option value="Week">Tuần</option>
            <option value="Month">Tháng</option>
        </select>

        <span class="topbar-username">@AuthService.CurrentUser?.FullName</span>

        <button class="btn-icon" @onclick="Logout" title="Đăng xuất">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </button>
    </div>
</header>

@code {
    protected override void OnInitialized() => State.OnChange += StateHasChanged;
    public void Dispose() => State.OnChange -= StateHasChanged;

    private void OnViewModeChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<ViewMode>(e.Value?.ToString(), out var mode))
            State.SetViewMode(mode);
    }

    private void Logout()
    {
        AuthService.Logout();
        Nav.NavigateTo("/login");
    }
}
