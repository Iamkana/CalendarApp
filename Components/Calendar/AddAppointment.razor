@implements IDisposable
@inject CalendarState State
@inject IAppointmentService AppointmentService
@inject AuthService AuthService

<!-- Overlay backdrop -->
<div class="ap-overlay @(State.IsAddFormOpen ? "open" : "")" @onclick="CloseIfBackdrop">
    <!-- Slide panel -->
    <div class="ap-panel @(State.IsAddFormOpen ? "open" : "")" @onclick:stopPropagation="true">

        <!-- Panel Header -->
        <div class="ap-header">
            <button class="btn-icon ap-close" @onclick="Close" title="Đóng">✕</button>
            <div class="ap-header-actions">
                <button class="btn btn-primary ap-save"
                        disabled="@(!CanSave)"
                        @onclick="TrySave"
                        id="btn-save-appointment">
                    Lưu
                </button>
            </div>
        </div>

        <!-- Title -->
        <div class="ap-body">
            <input class="input-field input-title"
                   id="appt-name"
                   placeholder="Thêm tiêu đề"
                   @bind="_name" @bind:event="oninput"
                   autocomplete="off" />

            <!-- DateTime row -->
            <div class="ap-row">
                <span class="ap-icon">🕐</span>
                <div class="ap-datetime-group">
                    <input type="datetime-local" id="appt-start"
                           value="@_startStr"
                           @onchange="OnStartChanged" />
                    <span class="ap-datetime-sep">→</span>
                    <input type="datetime-local" id="appt-end"
                           value="@_endStr"
                           @onchange="OnEndChanged" />
                </div>
            </div>


            <!-- Location -->
            <div class="ap-row">
                <span class="ap-icon">📍</span>
                <input class="input-field" id="appt-location" placeholder="Thêm địa điểm" @bind="_location" />
            </div>


            <!-- Color picker -->
            <div class="ap-row">
                <span class="ap-icon">🎨</span>
                <div class="color-picker-row">
                    @foreach (var c in ColorOptions)
                    {
                        <button class="color-dot @(_color == c ? "selected" : "")"
                                style="background:@c"
                                @onclick="() => _color = c"
                                title="@c">
                        </button>
                    }
                </div>
            </div>

            <!-- Group meeting toggle -->
            <div class="ap-row">
                <span class="ap-icon">👥</span>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_isGroupMeeting" />
                    <span class="checkbox-box" style="background:@(_isGroupMeeting ? "var(--accent-blue)" : "transparent")">
                        @if (_isGroupMeeting)
                        {
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                    </span>
                    <span>Đây là cuộc họp nhóm</span>
                </label>
            </div>

            <!-- Reminder -->
            <div class="ap-row">
                <span class="ap-icon">🔔</span>
                <select class="input-select" id="appt-reminder" @bind="_reminderMinutes">
                    <option value="0">Không nhắc</option>
                    <option value="5">5 phút trước</option>
                    <option value="10">10 phút trước</option>
                    <option value="15">15 phút trước</option>
                    <option value="30">30 phút trước</option>
                    <option value="60">1 giờ trước</option>
                    <option value="120">2 giờ trước</option>
                    <option value="1440">1 ngày trước</option>
                </select>
            </div>

            <!-- ── Conflict / Group-match Alerts ─────────────────────── -->
            @if (_conflictAppt is not null && _groupMatch is null)
            {
                <div class="alert alert-warning">
                    <span>⚠️ Bạn đã có cuộc hẹn <strong>"@_conflictAppt.Name"</strong> vào thời điểm này.</span>
                    <div class="alert-actions">
                        <button class="btn btn-primary" @onclick="ReplaceOld">Thay thế cuộc hẹn cũ</button>
                        <button class="btn btn-ghost" @onclick="ClearAlert">Chọn thời gian khác</button>
                    </div>
                </div>
            }

            @if (_groupMatch is not null)
            {
                <div class="alert alert-info">
                    <span>💡 Tìm thấy cuộc họp nhóm <strong>"@_groupMatch.Name"</strong> trùng tên và thời lượng. Bạn có muốn tham gia?</span>
                    <div class="alert-actions">
                        <button class="btn btn-primary" @onclick="JoinGroup">Tham gia cuộc họp nhóm này</button>
                        <button class="btn btn-ghost" @onclick="ClearAlert">Hủy</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // ── Field values ─────────────────────────────────────────────────────────
    private string   _name         = string.Empty;
    private string   _location     = string.Empty;
    private DateTime _start        = DateTime.Now;
    private DateTime _end          = DateTime.Now.AddHours(1);

    private bool     _isGroupMeeting;

    private string   _color        = "#4285f4";
    private int      _reminderMinutes = 0;

    // ── Conflict state ────────────────────────────────────────────────────────
    private Appointment? _conflictAppt;
    private Appointment? _groupMatch;

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static readonly string[] ColorOptions =
    {
        "#4285f4","#ea4335","#34a853","#fbbc04","#00bcd4",
        "#a142f4","#f06292","#ff7043","#26a69a","#78909c"
    };



    private string _startStr => _start.ToString("yyyy-MM-ddTHH:mm");
    private string _endStr   => _end.ToString("yyyy-MM-ddTHH:mm");

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_name) &&
        _end > _start &&
        _conflictAppt is null &&
        _groupMatch   is null;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override void OnInitialized() => State.OnChange += OnStateChanged;

    private void OnStateChanged()
    {
        if (State.IsAddFormOpen)
        {
            ResetForm();
            _start = State.PreselectedTime;
            _end   = State.PreselectedEndTime;
        }
        InvokeAsync(StateHasChanged);
    }

    private void ResetForm()
    {
        _name            = string.Empty;
        _location        = string.Empty;

        _isGroupMeeting  = false;

        _color           = "#4285f4";
        _reminderMinutes = 0;
        _conflictAppt    = null;
        _groupMatch      = null;
    }

    // ── Event handlers ────────────────────────────────────────────────────────
    private void OnStartChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            var dur = _end - _start;
            _start = dt;
            _end   = dt + dur;
        }
        ClearAlert();
    }

    private void OnEndChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            _end = dt;
        ClearAlert();
    }


    private void Close() => State.CloseAddForm();

    private void CloseIfBackdrop() => State.CloseAddForm();

    private void ClearAlert() { _conflictAppt = null; _groupMatch = null; }

    // ── Save flow ──────────────────────────────────────────────────────────────
    private void TrySave()
    {
        ClearAlert();
        var candidate = BuildAppointment();

        // 1. Check group-meeting match first
        var gm = AppointmentService.CheckGroupMeetingMatch(candidate);
        if (gm is not null) { _groupMatch = gm; return; }

        // 2. Check regular conflict
        var conflict = AppointmentService.CheckConflict(candidate);
        if (conflict is not null) { _conflictAppt = conflict; return; }

        // 3. All clear → save
        CommitSave(candidate);
    }

    private void ReplaceOld()
    {
        var candidate = BuildAppointment();
        AppointmentService.ReplaceAppointment(_conflictAppt!.Id, candidate);
        ClearAlert();
        State.CloseAddForm();
    }

    private void JoinGroup()
    {
        var uid = AuthService.CurrentUser?.Id ?? string.Empty;
        AppointmentService.JoinGroupMeeting(_groupMatch!.Id, uid);
        ClearAlert();
        State.CloseAddForm();
    }

    private void CommitSave(Appointment appt)
    {
        AppointmentService.AddAppointment(appt);
        State.CloseAddForm();
    }

    private Appointment BuildAppointment() => new()
    {
        Name             = _name.Trim(),
        Location         = _location.Trim(),
        StartTime        = _start,
        EndTime          = _end,

        IsGroupMeeting   = _isGroupMeeting,
        ReminderMinutes  = _reminderMinutes,
        OwnerId          = AuthService.CurrentUser?.Id ?? string.Empty,

        Color            = _color,
        Attendees        = _isGroupMeeting
                              ? new List<string> { AuthService.CurrentUser?.Id ?? string.Empty }
                              : new List<string>(),
    };

    public void Dispose() => State.OnChange -= OnStateChanged;
}
